<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tienda MJC</title>

  <style>
    body{
      margin:0;
      padding:20px;
      font-family:Arial, sans-serif;
      background:#f2f2f2;
    }

    h1{
      text-align:center;
      margin-bottom:30px;
    }

    /* CONTENEDOR DE PRODUCTOS */
    .productos{
      display:grid;

      /* 3 columnas */
      grid-template-columns:repeat(3, 1fr);

      gap:20px;
    }

    /* TARJETA */
    .producto{
      background:white;
      border-radius:15px;
      overflow:hidden;
      box-shadow:0 4px 10px rgba(0,0,0,0.1);

      transition:0.2s;
    }

    .producto:hover{
      transform:scale(1.03);
    }

    /* IMAGEN */
    .producto img{
      width:100%;
      height:220px;
      object-fit:cover;
      display:block;
    }

    /* NOMBRE */
    .nombre{
      padding:15px;
      text-align:center;
      font-size:18px;
      font-weight:bold;
    }

    /* RESPONSIVE PARA CELULAR */
    @media(max-width:700px){

      .productos{
        grid-template-columns:repeat(2, 1fr);
      }

    }

    @media(max-width:500px){

      .productos{
        grid-template-columns:1fr;
      }

    }
  </style>
</head>
<body>

  <h1>MJC Diseños</h1>

  <div class="productos">

    <!-- PRODUCTO 1 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?1">
      <div class="nombre">Producto 1</div>
    </div>

    <!-- PRODUCTO 2 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?2">
      <div class="nombre">Producto 2</div>
    </div>

    <!-- PRODUCTO 3 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?3">
      <div class="nombre">Producto 3</div>
    </div>

    <!-- PRODUCTO 4 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?4">
      <div class="nombre">Producto 4</div>
    </div>

    <!-- PRODUCTO 5 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?5">
      <div class="nombre">Producto 5</div>
    </div>

    <!-- PRODUCTO 6 -->
    <div class="producto">
      <img src="https://picsum.photos/300/300?6">
      <div class="nombre">Producto 6</div>
    </div>

  </div>

</body>
</html>